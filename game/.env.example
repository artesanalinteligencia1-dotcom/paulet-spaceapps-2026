# Online rooms (Firebase Realtime Database). Copy to .env.local and fill in from the Firebase console
# (Project settings > Your apps > Web app > firebaseConfig). Not secrets: the database rules protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
