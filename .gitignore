
# Optional media made with models from Chinese companies: not published until an adviser approves
media/act-videos/optional-cn/

# HyperFrames work files and draft renders
media/mission-videos/*/.hyperframes/
media/mission-videos/*/node_modules/
media/mission-videos/*/*-draft.mp4
media/mission-videos/*/renders/
media/voices/test/

# Video projects: shared assets are copied from media/video-kit by tools/build.py and voices are regenerated by tools/vo.py
media/*-videos/**/assets/kit/
media/*-videos/**/assets/vo/*.wav
media/*-videos/**/.hyperframes/
media/*-videos/**/node_modules/
media/*-videos/**/renders/
# Full-quality masters stay local; the web copies that ship are in game/public/videos/
media/mission-videos/*/*.mp4
media/act-videos/*.mp4
media/act-videos/*/*.mp4
!media/act-videos/main/veo/*.mp4
media/mission-videos/*/review/
media/act-videos/*/review/
media/act-videos/*/*.mp4
!media/act-videos/main/veo/*.mp4
